---
import { type Lang, strings } from "../i18n/index.ts";
import EmailAsk from "./EmailAsk.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const l = strings(lang).logs;
const crawlerGrid =
  "md:grid md:grid-cols-[150px_170px_150px_110px_90px_190px_minmax(0,1fr)] md:gap-4";
const referralGrid = "md:grid md:grid-cols-[160px_90px_190px_minmax(0,1fr)] md:gap-4";
const header = "hidden px-5 py-2 font-mono text-xs tracking-[0.06em] text-muted uppercase";
const badge =
  "rounded-full px-2 py-px font-mono text-xs font-bold data-[purpose=search_index]:bg-search data-[purpose=search_index]:text-search-ink data-[purpose=training]:bg-training data-[purpose=training]:text-training-ink data-[purpose=user_fetch]:bg-fetch data-[purpose=user_fetch]:text-fetch-ink";
---
<section id="logs" aria-labelledby="logs-h2" class="flex flex-col gap-3.5 px-5 pt-12 md:gap-[22px] md:px-[120px] md:pt-[88px]">
  <h2 id="logs-h2" class="m-0 font-mono text-2xl leading-tight font-extrabold tracking-[-0.02em] md:text-[34px]">{l.h2}</h2>
  <p class="m-0 max-w-[860px] text-muted">{l.intro}</p>
  <p data-log-status role="status" class="sr-only"></p>

  <div data-log-progress hidden class="flex flex-col gap-3.5 rounded-panel border border-line bg-surface p-4 font-mono text-sm md:px-[26px] md:py-6 md:text-[15px]">
    <div class="flex flex-wrap justify-between gap-2"><span id="log-progress-label" data-f="label" class="break-all"></span><span data-f="amount" class="text-muted"></span></div>
    <div data-f="meter" role="progressbar" aria-labelledby="log-progress-label" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" class="h-2.5 overflow-hidden rounded-full bg-surface-2">
      <div data-f="bar" class="h-full w-0 bg-linear-to-r from-accent to-brand"></div>
    </div>
    <button type="button" data-log-cancel class="h-11 self-end rounded-btn border border-line px-[18px] font-mono font-bold text-ink">{l.cancel}</button>
  </div>

  <div data-log-unknown hidden class="flex flex-col gap-3 rounded-panel border border-warn bg-surface p-4 md:px-[26px] md:py-6">
    <p class="m-0 font-semibold">{l.unknown}</p>
    <code data-f="line" class="block rounded-btn bg-code p-3 font-mono text-[13px] break-all"></code>
    <form data-log-format class="m-0 flex flex-wrap items-end gap-3">
      <div class="flex flex-col gap-1">
        <label for="log-format" class="text-sm font-semibold">{l.formatLabel}</label>
        <select id="log-format" class="h-11 rounded-btn border border-line bg-surface px-3 font-mono text-sm">
          <option value="combined">{l.formats.combined}</option>
          <option value="cloudfront">{l.formats.cloudfront}</option>
          <option value="alb">{l.formats.alb}</option>
        </select>
      </div>
      <button type="submit" class="h-11 rounded-btn bg-brand px-5 font-mono text-sm font-extrabold text-white hover:bg-accent">{l.formatButton}</button>
    </form>
  </div>

  <p data-log-message hidden class="m-0 rounded-panel border border-line bg-surface p-4 font-semibold"></p>

  <div data-log-result hidden class="flex flex-col gap-3.5 md:gap-[22px]">
    <p data-f="meta" class="m-0 font-mono text-[13px] break-all text-muted md:text-sm"></p>
    <p data-f="headline" class="m-0 font-mono text-[25px] leading-[1.2] font-extrabold tracking-[-0.03em] md:text-[40px] md:leading-[1.15]"><span data-f="crawler-n" class="text-brand"></span> <span data-f="crawler-text"></span> <span data-f="chat-n" class="text-ok"></span> <span data-f="chat-text"></span></p>
    <p data-f="truncated" hidden class="m-0 rounded-btn border border-warn bg-surface p-3 text-sm text-warn">{l.truncated}</p>
    <p data-f="none" hidden class="m-0 text-muted">{l.noAi}</p>
    <EmailAsk lang={lang} variant="log" />

    <div data-f="crawlers" class="overflow-hidden rounded-panel border border-line bg-surface">
      <div class="border-b border-line bg-surface-2 px-4 py-2.5 font-mono font-bold md:px-5 md:py-3">{l.crawlersTitle}</div>
      <div role="table" aria-label={l.crawlersTitle} class="text-[15px]">
        <div role="row" class:list={[header, crawlerGrid]}>
          <span role="columnheader">{l.columns.vendor}</span><span role="columnheader">{l.columns.token}</span><span role="columnheader">{l.columns.purpose}</span><span role="columnheader" class="text-right">{l.columns.requests}</span><span role="columnheader" class="text-right">{l.columns.pages}</span><span role="columnheader">{l.columns.lastSeen}</span><span role="columnheader">{l.columns.topPages}</span>
        </div>
        <div data-f="crawler-rows" role="rowgroup"></div>
      </div>
    </div>

    <div class="grid gap-3.5 md:grid-cols-3 md:gap-6">
      <div data-f="referrals" class="overflow-hidden rounded-panel border border-line bg-surface md:col-span-2">
        <div class="border-b border-line bg-surface-2 px-4 py-2.5 font-mono font-bold md:px-5 md:py-3">{l.referralsTitle}</div>
        <div role="table" aria-label={l.referralsTitle} class="text-[15px]">
          <div role="row" class:list={[header, referralGrid]}>
            <span role="columnheader">{l.columns.product}</span><span role="columnheader" class="text-right">{l.columns.visits}</span><span role="columnheader">{l.columns.lastSeen}</span><span role="columnheader">{l.columns.landing}</span>
          </div>
          <div data-f="referral-rows" role="rowgroup"></div>
        </div>
      </div>
      <div data-f="search" class="overflow-hidden rounded-panel border border-line bg-surface">
        <div class="border-b border-line bg-surface-2 px-4 py-2.5 font-mono font-bold text-muted md:px-5 md:py-3">{l.searchTitle}</div>
        <div data-f="search-rows" class="flex flex-col"></div>
        <p class="m-0 px-4 pb-4 text-[13px] text-muted md:px-5">{l.searchNote}</p>
      </div>
    </div>
  </div>

  <template data-tpl="crawler-row">
    <div role="row" class:list={["flex flex-col gap-1 border-t border-line-soft px-4 py-3 md:items-start md:px-5 md:py-2.5", crawlerGrid]}>
      <span role="cell" data-f="vendor" class="text-sm text-muted md:text-[15px] md:text-ink"></span>
      <span role="cell" data-f="token" class="font-mono font-medium"></span>
      <span role="cell"><span data-f="purpose" class={badge}></span></span>
      <span role="cell" class="font-mono md:text-right"><span class="text-muted md:hidden">{l.columns.requests}: </span><span data-f="requests" class="font-bold"></span></span>
      <span role="cell" class="font-mono md:text-right"><span class="text-muted md:hidden">{l.columns.pages}: </span><span data-f="pages"></span></span>
      <span role="cell" class="font-mono text-muted"><span class="md:hidden">{l.columns.lastSeen}: </span><span data-f="last-seen"></span></span>
      <span role="cell" data-f="top-pages" class="font-mono text-sm whitespace-pre-line break-all"></span>
    </div>
  </template>

  <template data-tpl="referral-row">
    <div role="row" class:list={["flex flex-col gap-1 border-t border-line-soft px-4 py-3 md:px-5 md:py-2.5", referralGrid]}>
      <span role="cell" data-f="product" class="font-semibold"></span>
      <span role="cell" class="font-mono md:text-right"><span class="text-muted md:hidden">{l.columns.visits}: </span><span data-f="visits" class="font-bold"></span></span>
      <span role="cell" class="font-mono text-muted"><span class="md:hidden">{l.columns.lastSeen}: </span><span data-f="last-seen"></span></span>
      <span role="cell" data-f="landing" class="font-mono text-sm whitespace-pre-line break-all"></span>
    </div>
  </template>

  <template data-tpl="search-row">
    <div class="flex justify-between gap-3 px-4 py-3.5 font-mono md:px-5"><span data-f="token"></span><span data-f="requests" class="font-bold"></span></div>
  </template>
</section>

<script>
  import "../scripts/logs.ts";
</script>
