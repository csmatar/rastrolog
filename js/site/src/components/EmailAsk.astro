---
import { siteConfig } from "../../site.config.ts";
import { type Lang, strings } from "../i18n/index.ts";
import { kitFormAction } from "../lib/kit.ts";

interface Props {
  lang: Lang;
  variant: "checker" | "log" | "band";
}

const { lang, variant } = Astro.props;
const t = strings(lang);
const general = kitFormAction(siteConfig.kit.general);
const latam = kitFormAction(siteConfig.kit.latam);
const latamByDefault = lang === "es";
const band = variant === "band";
const copy =
  variant === "checker"
    ? {
        title: t.ask.checker.title,
        button: t.ask.checker.button,
        fine: "",
        sentTitle: t.ask.checker.sentTitle,
      }
    : variant === "log"
      ? {
          title: t.ask.log.title,
          button: t.ask.log.button,
          fine: t.ask.log.fine,
          sentTitle: t.ask.log.sentTitle,
        }
      : {
          title: null,
          button: t.signup.button,
          fine: t.signup.fine,
          sentTitle: t.signup.sentTitle,
        };
const box = {
  checker: "rounded-ask border border-brand-line bg-brand-soft p-5 md:p-8",
  log: "rounded-ask border border-accent-line bg-accent-soft p-5 md:p-8",
  band: "",
}[variant];
const buttonTone = {
  checker: "bg-brand text-white hover:bg-accent",
  log: "bg-accent text-white hover:bg-accent-hover",
  band: "bg-ink text-white hover:bg-ink-2",
}[variant];
const checkTone = { checker: "accent-brand", log: "accent-accent", band: "accent-ink" }[variant];
const id = `${variant}-email`;
---
<div data-email-ask={variant} hidden={!band} class={box}>
  <form method="post" action={latamByDefault ? latam : general} data-email-form={variant} data-action-general={general} data-action-latam={latam} class:list={["m-0 flex flex-col gap-2.5", !band && "md:grid md:grid-cols-11 md:items-center md:gap-10"]}>
    {copy.title !== null && (
      <div class="flex flex-col gap-2.5 md:col-span-6">
        <h3 class="m-0 font-mono text-[19px] leading-[1.3] font-extrabold tracking-[-0.02em] md:text-2xl md:leading-[1.25]">{copy.title}</h3>
        <p data-ask-body class="m-0 text-[15px] text-ink-2 md:text-base"></p>
      </div>
    )}
    <div class:list={["flex flex-col gap-2.5", !band && "md:col-span-5"]}>
      <label for={id} class="text-[15px] font-semibold">{t.ask.email}</label>
      <div class="flex flex-col gap-2.5 md:flex-row">
        <input id={id} name="email_address" type="email" required autocomplete="email" placeholder={t.ask.placeholder} class="h-[54px] min-w-0 grow rounded-input border-2 border-line bg-surface px-3.5 text-[17px] text-ink" />
        <button type="submit" data-email-submit class:list={["h-[54px] shrink-0 rounded-input px-5 font-mono text-[15px] font-extrabold whitespace-nowrap", buttonTone]}>{copy.button}</button>
      </div>
      {variant === "checker" && <input type="hidden" name="fields[checked_domain]" value="" data-checked-domain />}
      <label data-latam hidden={band} class="flex min-h-11 cursor-pointer items-center gap-2.5 text-[15px]">
        <input type="checkbox" data-latam-box checked={latamByDefault} class:list={["size-5 shrink-0", checkTone]} />
        {t.ask.latam}
      </label>
      <p data-ask-fine class:list={["m-0 text-[13px]", band ? "text-white" : "text-muted"]}>{copy.fine}</p>
      <p data-email-error role="alert" hidden class:list={["m-0 text-sm font-semibold", band ? "text-white" : "text-err"]}>{t.ask.error}</p>
    </div>
  </form>
  <div data-email-sent={variant} role="status" tabindex="-1" hidden class:list={["flex flex-col gap-1", band && "rounded-xl bg-white/15 p-4"]}>
    <strong class="font-mono text-[17px]">✓ {copy.sentTitle}</strong>
    <p data-sent-body class:list={["m-0 text-[15px]", !band && "text-ink-2"]}></p>
    {variant === "checker" && <p class="m-0 text-[15px] break-all">{t.ask.checker.linkLabel} <a data-report-link href="#top"></a></p>}
  </div>
</div>

<script>
  import "../scripts/email.ts";
</script>
