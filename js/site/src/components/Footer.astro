---
import { type Lang, strings } from "../i18n/index.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings(lang).footer;
---
<footer class="flex flex-col gap-2 border-t border-line bg-surface px-5 pt-[22px] pb-7 text-[13px] text-muted md:flex-row md:justify-between md:gap-6 md:px-[120px] md:pt-7 md:pb-8 md:text-sm">
  <span class="font-mono">{t.license} · <a href="https://github.com/csmatar/rastrolog">github.com/csmatar/rastrolog</a></span>
  <span>{t.analytics}</span>
</footer>
