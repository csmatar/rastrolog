---
import { num } from "../i18n/format.ts";
import { type Lang, strings } from "../i18n/index.ts";
import { chatCount, crawlerCount, vendorCount, vendors } from "../lib/signals.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings(lang).stats;
const stats = [
  { value: num(lang, crawlerCount), label: t.crawlers, color: "text-brand" },
  { value: num(lang, vendorCount), label: t.companies, color: "text-brand" },
  { value: num(lang, chatCount), label: t.chats, color: "text-accent" },
  { value: "0", label: t.bytes, color: "text-ok" },
];
const names = vendors().map((v) => v.name);
---
<section aria-label={t.label} class="flex flex-col gap-5 border-b border-line bg-surface px-5 pt-[26px] pb-6 md:gap-6 md:px-[120px] md:pt-9 md:pb-[34px]">
  <dl class="m-0 grid grid-cols-2 gap-x-4 gap-y-[18px] font-mono md:grid-cols-4 md:gap-6">
    {stats.map((s) => (
      <div class="flex flex-col-reverse gap-0.5">
        <dt class="text-[13px] text-muted md:text-sm">{s.label}</dt>
        <dd class:list={["m-0 text-[40px] leading-[1.05] font-extrabold tracking-[-0.04em] md:text-[52px]", s.color]}>{s.value}</dd>
      </div>
    ))}
  </dl>
  <p class="m-0 flex flex-wrap items-baseline gap-x-3.5 gap-y-1 font-mono text-sm font-bold text-muted md:gap-x-6 md:gap-y-1.5 md:text-base">
    <span class="w-full text-[11px] tracking-[0.1em] uppercase md:w-auto md:text-xs">{t.from}</span>
    {names.map((name) => <span>{name}</span>)}
  </p>
</section>
