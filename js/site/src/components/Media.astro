---
import { siteConfig } from "../../site.config.ts";
import { type Lang, strings } from "../i18n/index.ts";
import { youtubeEmbedSrc } from "../lib/youtube.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings(lang).media;
const { articles, youtubeId } = siteConfig;
const embed = youtubeId === null ? null : youtubeEmbedSrc(youtubeId);
if (youtubeId !== null && embed === null) {
  throw new Error(`YOUTUBE_ID in site.config.ts isn't a YouTube video ID: ${youtubeId}`);
}
const show = articles.length > 0 || embed !== null;
---
{show && (
  <section id="media" aria-labelledby="media-h2" class="flex flex-col gap-3.5 px-5 pt-12 md:gap-[22px] md:px-[120px] md:pt-[88px]">
    <h2 id="media-h2" class="m-0 font-mono text-2xl leading-tight font-extrabold tracking-[-0.02em] md:text-[34px]">{t.h2}</h2>
    {articles.length > 0 && (
      <ul class="m-0 flex list-none flex-col gap-2 p-0">
        {articles.map((a) => <li><a href={a.url} class="inline-flex min-h-11 items-center text-lg font-semibold">{a.title}</a></li>)}
      </ul>
    )}
    {embed !== null && (
      <div data-video={embed} data-video-title={t.videoTitle} class="flex aspect-video max-w-3xl items-center justify-center overflow-hidden rounded-panel border border-line bg-ink">
        <button type="button" class="inline-flex min-h-11 items-center rounded-btn bg-brand px-5 font-mono font-extrabold text-white">{t.play}</button>
      </div>
    )}
  </section>
)}

<script>
  import "../scripts/video.ts";
</script>
