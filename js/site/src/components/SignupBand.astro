---
import { type Lang, strings } from "../i18n/index.ts";
import EmailAsk from "./EmailAsk.astro";
import SampleAlert from "./SampleAlert.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings(lang).signup;
---
<section id="signup" aria-labelledby="signup-h2" class="px-5 pt-11 pb-14 md:px-[120px] md:pt-[88px] md:pb-[88px]">
  <div class="grid gap-3.5 rounded-band bg-brand px-5 pt-[26px] pb-[22px] text-white md:grid-cols-12 md:items-center md:gap-12 md:px-[52px] md:py-12">
    <div class="flex flex-col gap-4 md:col-span-7">
      <p class="m-0 font-mono text-[13px] font-bold md:text-sm">{t.kicker}</p>
      <h2 id="signup-h2" class="m-0 font-mono text-[25px] leading-[1.2] font-extrabold tracking-[-0.03em] md:text-4xl md:leading-[1.15]">{t.h2}</h2>
      <p class="m-0 text-base md:text-[17px]">{t.body}</p>
      <EmailAsk lang={lang} variant="band" />
    </div>
    <SampleAlert lang={lang} class="md:col-span-5" />
  </div>
</section>
