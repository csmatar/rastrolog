---
import { fmt } from "../i18n/format.ts";
import { type Lang, strings } from "../i18n/index.ts";
import { sampleAlert } from "../lib/signals.ts";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = strings(lang).signup.sample;
const sample = sampleAlert();
---
<figure class:list={[className, "m-0 flex flex-col overflow-hidden rounded-panel bg-surface text-ink shadow-alert"]}>
  <figcaption class="flex justify-between gap-2 bg-surface-2 px-3.5 py-2.5 font-mono text-[11px] text-muted md:px-[18px] md:py-3 md:text-xs">
    <span class="font-bold">{t.label}</span><span>{t.note}</span>
  </figcaption>
  <div class="flex flex-col gap-2.5 px-4 pt-3.5 pb-4 text-sm md:gap-3 md:px-[22px] md:pt-5 md:pb-[22px] md:text-[15px]">
    <div class="flex flex-col gap-0.5 border-b border-line-soft pb-3">
      <span class="text-[13px] text-muted">{t.from}</span>
      <strong class="text-[15px] md:text-base">{fmt(t.subject, { token: sample.token })}</strong>
    </div>
    <p class="m-0">{fmt(t.body, { vendor: sample.vendorName })} <a href={sample.docsUrl}>{fmt(t.docs, { vendor: sample.vendorName })}</a></p>
    <p class="m-0">{t.block}</p>
    <pre class="m-0 rounded-input bg-code px-3.5 py-3 font-mono text-[13px] leading-[1.7] md:text-sm"><code>{`User-agent: ${sample.token}\nDisallow: /`}</code></pre>
  </div>
</figure>
