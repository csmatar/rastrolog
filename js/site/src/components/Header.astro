---
import { type Lang, strings } from "../i18n/index.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings(lang);
const home = lang === "es" ? "/es/" : "/";
const other =
  lang === "es"
    ? { code: "EN", name: "English", href: "/", lang: "en" }
    : { code: "ES", name: "Español", href: "/es/", lang: "es" };
const links = [
  { href: "#checker", label: t.nav.checker },
  { href: "#logs", label: t.nav.logs },
  { href: "#install", label: t.nav.install },
];
const github = "https://github.com/csmatar/rastrolog";
---
<header class="flex items-center justify-between px-5 py-3 md:px-[120px] md:py-[18px]">
  <a href={home} class="flex min-h-11 items-center gap-2.5 font-mono text-[19px] font-extrabold text-ink no-underline md:text-[21px]">
    <span class="text-brand" aria-hidden="true">›_</span><span>rastrolog</span>
  </a>
  <nav aria-label={t.nav.label} class="hidden items-center gap-1.5 text-[15px] md:flex">
    {links.map((link) => <a href={link.href} class="inline-flex h-11 items-center px-3 text-ink no-underline hover:text-accent">{link.label}</a>)}
    <a href={github} class="inline-flex h-11 items-center gap-1.5 px-3 text-ink no-underline hover:text-accent">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" /></svg>
      {t.nav.github}
    </a>
    <div role="group" aria-label={t.nav.language} class="mx-2 flex overflow-hidden rounded-btn border border-line bg-surface font-mono text-[13px]">
      <a href={home} aria-current="page" class="inline-flex h-11 items-center bg-surface-2 px-3 font-bold text-ink no-underline">{lang.toUpperCase()}</a>
      <a href={other.href} lang={other.lang} hreflang={other.lang} class="inline-flex h-11 items-center px-3 text-muted no-underline hover:text-accent"><span aria-hidden="true">{other.code}</span><span class="sr-only">{other.name}</span></a>
    </div>
    <a href="#top" class="inline-flex h-11 items-center rounded-btn bg-brand px-[18px] font-mono text-sm font-extrabold text-white no-underline hover:bg-accent hover:text-white">{t.nav.cta}</a>
  </nav>
  <div class="flex items-center gap-1.5 md:hidden">
    <a href={other.href} lang={other.lang} hreflang={other.lang} class="inline-flex h-11 items-center px-2.5 font-mono text-sm text-muted no-underline"><span aria-hidden="true">{other.code}</span><span class="sr-only">{other.name}</span></a>
    <details class="relative">
      <summary class="flex size-11 cursor-pointer items-center justify-center rounded-input border border-line bg-surface text-ink">
        <span class="sr-only">{t.nav.menu}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" /></svg>
      </summary>
      <nav aria-label={t.nav.label} class="absolute right-0 z-10 mt-2 flex w-56 flex-col rounded-panel border border-line bg-surface p-2 shadow-panel">
        {links.map((link) => <a href={link.href} class="flex min-h-11 items-center rounded-btn px-3 text-ink no-underline hover:bg-surface-2">{link.label}</a>)}
        <a href={github} class="flex min-h-11 items-center rounded-btn px-3 text-ink no-underline hover:bg-surface-2">{t.nav.github}</a>
      </nav>
    </details>
  </div>
</header>
