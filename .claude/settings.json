{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv sync --all-extras)",
      "Bash(uv lock)",
      "Bash(uv build)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format *)",
      "Bash(uv run mypy *)",
      "Bash(uv run rastrolog *)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run build *)",
      "Bash(pnpm run typecheck *)",
      "Bash(pnpm run lint *)",
      "Bash(pnpm run size *)",
      "Bash(pnpm -r run test)",
      "Bash(pnpm -r run build)",
      "Bash(pnpm -r run typecheck)",
      "Bash(pnpm run format)",
      "Bash(pnpm --filter rastrolog run test:bundle)",
      "Bash(pnpm --filter rastrolog run size)",
      "Bash(pnpm --filter rastrolog run e2e)",
      "Bash(pnpm --filter @rastrolog/core run codegen)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(uvx zizmor *)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(uv publish *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main*)"
    ]
  }
}
