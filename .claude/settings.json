{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv build *)",
      "Bash(uv add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm run *)",
      "Bash(pnpm -r *)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm exec *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(gh issue *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh run *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(uv publish *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)"
    ]
  }
}
